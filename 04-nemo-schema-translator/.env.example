# Set NEMO_IMAGE_TAG based on 03-nemo-batch-operator output path. Schema is built from all runs under
# ../03-nemo-batch-operator/data/output/nemo/{NEMO_IMAGE_TAG}/{NEMO_WORKFLOW}/
NEMO_IMAGE_TAG=0.1.2
# nemo workflow: wigits or dragen; override per call, e.g. `make run NEMO_WORKFLOW=dragen`
NEMO_WORKFLOW=wigits

# Landing Zone database and key prefix default per workflow (see translator.py); set to override
# no trailing slash
#LZ_KEY_PREFIX="tidywigits/v1"
#LZ_DBNAME="tidywigits"
