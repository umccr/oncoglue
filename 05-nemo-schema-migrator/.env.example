# nemo workflow: wigits or dragen; override per call, e.g. `make run NEMO_WORKFLOW=dragen`
# Sets the database: tidywigits or tidydragen
NEMO_WORKFLOW=wigits

# Package version of the schema; one per workflow, see ../04-nemo-schema-translator/schema/{package}/
SCHEMA_VERSION_WIGITS=0.2.1
SCHEMA_VERSION_DRAGEN=0.1.0

# Landing Zone bucket structure - See https://github.com/umccr/infrastructure-unimelb/issues/4
# The bucket 03-nemo-batch-operator pushed to (its DATALAKE_BUCKET), with s3:// and no trailing slash
LZ_BUCKET="s3://my-data-landing-zone-111111111111-us-southeast-10-an"

# Athena workgroup name
ATHENA_WORKGROUP="primary"

# Allowed modes are - create, view, drop
MODE=create

# Set it to "false" to execute query
DRY_RUN=true

# AWS region name
REGION_NAME=ap-southeast-2
